<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.wkkya.fusionpdf</id>
    <name>FusionPDF</name>

    <!--  版本  -->
    <version>1.0.1</version>

    <vendor>wangkuan</vendor>

    <!-- 指定兼容的 IntelliJ IDEA 版本范围 -->
    <idea-version since-build="233.1" until-build="243.*" />

    <depends>com.intellij.modules.platform</depends>

    <description>
        <![CDATA[
            FusionPDF integrates PDF viewing into IntelliJ IDEA, providing seamless theme matching and customization options for background and text colors. It supports zooming functionality for detailed views, scanned image PDFs for versatile document handling, and includes features like quick navigation, search within PDFs, and bookmark management to significantly enhance productivity and reading experience.
        ]]>
    </description>


    <!--  更新日志  -->
    <change-notes>init</change-notes>

    <extensions defaultExtensionNs="com.intellij">
        <registryKey defaultValue="false" key="fusion.pdf.debug" description="Enables PDF viewer debug mode"/>
        <registryKey defaultValue="10000" key="fusion.pdf.jcefLatchTimeout" description="Sets maximum wait time for the web-view to load"/>
        <registryKey defaultValue="false" key="fusion.pdf.enableExperimentalFeatures" description="Enables PDF viewer experimental features"/>
        <registryKey defaultValue="true" key="fusion.pdf.use.jcef.osr.view" description="Enables JCEF off-screen rendering"/>

        <applicationService serviceImplementation="com.github.wkkya.fusionpdf.settings.FusionPDFSettings"/>

        <applicationConfigurable instance="com.github.wkkya.fusionpdf.settings.FusionPDFConfigurable" displayName="FusionPDF"/>

        <toolWindow id="FusionPDF" anchor="bottom" factoryClass="com.github.wkkya.fusionpdf.factory.FusionPDFToolWindowFactory" />


    </extensions>


    <applicationListeners>

        <listener class="com.github.wkkya.fusionpdf.settings.FusionPDFInvertColorsListener"
                  topic="com.intellij.openapi.editor.colors.EditorColorsListener"/>
    </applicationListeners>



</idea-plugin>
